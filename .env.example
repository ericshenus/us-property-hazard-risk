# All hazard lookups use free, keyless public APIs (US Census Bureau geocoder,
# FEMA NFHL, USGS) -- no API keys are required to run this server.

# Host/port the server binds to. Defaults are fine for both local dev and
# the Docker image; only override if you need something else.
MCP_HOST=0.0.0.0
MCP_PORT=8000
